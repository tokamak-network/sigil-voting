# Sepolia deployment configuration (Foundry/Hardhat)
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=your_etherscan_api_key_optional

# MACI Coordinator key (Baby Jubjub EdDSA)
# Used by coordinator to decrypt votes during processing
COORDINATOR_PRIVATE_KEY=0x_YOUR_COORDINATOR_KEY_HERE

# Frontend (Next.js) - prefix must be NEXT_PUBLIC_ to expose to browser
# Optional: override default public RPC fallbacks (publicnode → rpc.sepolia.org → tenderly)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Circuit mode: 'dev' (v2, depth=2) or 'prod' (depth=4, maxVoters=624)
# NEXT_PUBLIC_CIRCUIT_MODE=dev

# Gasless voting relayer — built into the Next.js app at /api/relay/publish-message
# Set both vars to enable gasless voting (users pay no gas for casting votes)
# NEXT_PUBLIC_RELAYER_URL=http://localhost:3000   ← points to this app itself
# RELAYER_PRIVATE_KEY=0x_RELAYER_WALLET_KEY_HERE  ← must have Sepolia ETH for gas
